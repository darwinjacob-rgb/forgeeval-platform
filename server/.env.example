# ====================================================
# ForgeEval Backend — Environment Configuration
# ====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ====================================================

# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeval?schema=public"

# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (for CORS) ──────────────────────────
# Local dev:
FRONTEND_URL="http://localhost:5173"
# Production (Render env var — set to your Vercel deployment URL):
# FRONTEND_URL="https://YOUR-PROJECT.vercel.app"

# ── JWT ───────────────────────────────────────────────
JWT_SECRET="CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING"
JWT_REFRESH_EXPIRES_IN="30d"

# ── AI Provider (optional) ───────────────────────────
AI_PROVIDER=""
AI_MODEL=""
AI_API_KEY=""

# ── Security ─────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
