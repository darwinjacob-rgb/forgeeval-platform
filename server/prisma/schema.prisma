// ====================================================
// ForgeEval — Prisma Schema
// Complete database model for AI-Powered Hackathon Evaluation
// ====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────

enum UserRole {
  ADMIN
  ORGANIZER
  JUDGE
  PARTICIPANT
}

enum HackathonStatus {
  DRAFT
  ACTIVE
  EVALUATING
  CONCLUDED
  ARCHIVED
}

enum ProblemDifficulty {
  CRITICAL
  HARD
  MEDIUM
  EASY
}

enum ProblemStatus {
  ACTIVE
  EVALUATING
  CONCLUDED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  ANALYZING
  ANALYZED
  FAILED
}

enum IngestionStatus {
  PENDING
  CLONING
  INGESTING
  READY
  FAILED
}

enum RequirementCategory {
  FUNCTIONAL
  SECURITY
  PERFORMANCE
  UI_UX
  DOCUMENTATION
  TESTING
  TECHNICAL
  INNOVATION
}

enum RequirementPriority {
  HIGH
  MEDIUM
  LOW
}

enum ProblemAnalysisStatus {
  UNANALYZED
  ANALYZING
  ANALYZED
  FAILED
}

enum RequirementResultStatus {
  SATISFIED
  PARTIAL
  MISSING
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  VERIFIED
  MITIGATED
  DISMISSED
}

enum FindingCategory {
  SECURITY
  ARCHITECTURE
  CODE_QUALITY
  TESTING
  PERFORMANCE
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  NOT_CONFIGURED
}

enum PipelineComponentStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum EvalDimension {
  FUNCTIONAL
  TECHNICAL
  SECURITY
  PERFORMANCE
  UI_UX
  DOCUMENTATION
  CODE_QUALITY
  INNOVATION
}

enum RuntimeTestStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
  NOT_CONFIGURED
}

enum AuditStatus {
  SECURE
  OUTDATED
  VULNERABLE
}

enum BuildStatus {
  SUCCESS
  WARNING
  FAILED
}

// ── Models ───────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PARTICIPANT)
  avatar       String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMembers      TeamMember[]
  judgeAssignments Judge[]
  judgeScores      JudgeScore[]
  activityLogs     ActivityLog[]
  hackathonsJoined HackathonParticipant[]
  feedbacks        Feedback[]

  @@index([email])
  @@index([role])
}

model Hackathon {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  theme                String?
  rules                String?
  eligibility          String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  submissionDeadline   DateTime?
  status               HackathonStatus @default(DRAFT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  teams        Team[]
  judges       Judge[]
  problems     HackathonProblem[]
  participants HackathonParticipant[]

  @@index([status])
}

model HackathonParticipant {
  id           String   @id @default(cuid())
  hackathonId  String
  userId       String
  registeredAt DateTime @default(now())

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
  @@index([hackathonId])
  @@index([userId])
}

model HackathonProblem {
  id          String @id @default(cuid())
  hackathonId String
  problemId   String

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  problem   Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, problemId])
}

model Problem {
  id                      String                @id @default(cuid())
  code                    String                @unique
  title                   String
  description             String
  difficulty              ProblemDifficulty
  category                String
  status                  ProblemStatus         @default(ACTIVE)
  deadline                DateTime?
  inputRequirements       String[]
  outputRequirements      String[]
  functionalRequirements  String[]
  technicalRequirements   String[]
  securityRequirements    String[]
  performanceRequirements String[]
  uiUxRequirements        String[]
  docRequirements         String[]
  rawStatement            String?
  analysisStatus          ProblemAnalysisStatus @default(UNANALYZED)
  createdBy               String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  submissions  Submission[]
  requirements Requirement[]
  hackathons   HackathonProblem[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  inviteCode  String?  @unique
  hackathonId String
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon   Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  submissions Submission[]

  @@index([hackathonId])
  @@index([inviteCode])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("MEMBER")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Submission {
  id                 String           @id @default(cuid())
  teamId             String
  problemId          String
  projectName        String?
  projectDescription String?
  repositoryUrl      String
  githubUrl          String?
  repoOwner          String?
  repoName           String?
  branch             String           @default("main")
  demoUrl            String?
  docUrl             String?
  commitHash         String?
  language           String?
  framework          String?
  status             SubmissionStatus @default(PENDING)
  ingestionStatus    IngestionStatus  @default(PENDING)
  ingestedAt         DateTime?
  ingestionError     String?
  repoMetadata       Json?
  overallScore       Float?
  readmeContent      String?
  isReleased         Boolean          @default(false)
  submittedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Code metrics
  linesOfCode          Int?
  cyclomaticComplexity Float?
  testCoverage         Float?
  buildTimeSec         Float?
  vulnerabilitiesCount Int?
  exitCode             Int?
  buildStatus          BuildStatus?
  executionTime        String?

  // Criteria scores (denormalized for quick access)
  scoreRequirement   Float?
  scoreCodeQuality   Float?
  scoreSecurity      Float?
  scoreTesting       Float?
  scoreDocumentation Float?
  scoreUiUx          Float?

  team               Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  problem            Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  files              SubmissionFile[]
  requirementResults RequirementResult[]
  aiAnalyses         AIAnalysis[]
  securityFindings   SecurityFinding[]
  runtimeTests       RuntimeTest[]
  judgeScores        JudgeScore[]
  finalResult        FinalResult?
  frameworks         SubmissionFramework[]
  dependencies       SubmissionDependency[]
  projectStructure   Json?
  runtimeLogs        Json?
  evaluationPipeline EvaluationPipeline?
  similarityResultsA SimilarityResult[]     @relation("SimilarityA")
  similarityResultsB SimilarityResult[]     @relation("SimilarityB")
  feedback           Feedback?

  @@index([teamId])
  @@index([problemId])
  @@index([status])
  @@index([ingestionStatus])
  @@index([submittedAt])
}

model SubmissionFile {
  id           String  @id @default(cuid())
  submissionId String
  path         String
  filename     String
  extension    String?
  size         Int?
  language     String?
  contentHash  String?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionFramework {
  id           String @id @default(cuid())
  submissionId String
  name         String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model SubmissionDependency {
  id           String      @id @default(cuid())
  submissionId String
  name         String
  version      String
  auditStatus  AuditStatus @default(SECURE)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Requirement {
  id                 String              @id @default(cuid())
  problemId          String
  code               String
  title              String
  description        String?
  category           RequirementCategory
  priority           RequirementPriority @default(MEDIUM)
  weight             Float               @default(1.0)
  keywords           String[]
  acceptanceCriteria String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  problem Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results RequirementResult[]

  @@unique([problemId, code])
  @@index([problemId])
  @@index([category])
}

model RequirementResult {
  id            String                  @id @default(cuid())
  submissionId  String
  requirementId String
  status        RequirementResultStatus
  confidence    Float
  evidence      String?
  filePath      String?
  lineStart     Int?
  lineEnd       Int?
  explanation   String?

  submission  Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([submissionId, requirementId])
  @@index([submissionId])
}

model AIAnalysis {
  id           String         @id @default(cuid())
  submissionId String
  status       AnalysisStatus @default(PENDING)
  summary      String?
  overallScore Float?
  strengths    String[]       @default([])
  weaknesses   String[]       @default([])
  assessments  Json?
  evidenceRefs Json?
  startedAt    DateTime?
  completedAt  DateTime?
  model        String?
  tokensUsed   Int?
  createdAt    DateTime       @default(now())

  submission      Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  dimensionScores AIDimensionScore[]
  reviewerResults ReviewerResult[]

  @@index([submissionId])
  @@index([status])
}

model AIDimensionScore {
  id          String        @id @default(cuid())
  analysisId  String
  dimension   EvalDimension
  score       Float
  weight      Float         @default(1.0)
  explanation String?
  evidence    Json?

  analysis AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

// ── New Enums & Models for extended features ────────────────────────────────────────

enum ReviewerType {
  FUNCTIONAL
  TECHNICAL
  SECURITY
  UI_UX
}

model ReviewerResult {
  id         String       @id @default(cuid())
  analysisId String
  reviewer   ReviewerType
  findings   Json // structured findings per reviewer
  evidence   Json // evidence references used by reviewer
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  analysis AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model SimilarityResult {
  id                String   @id @default(cuid())
  hackathonId       String
  submissionAId     String
  submissionBId     String
  similarityScore   Float
  matchingFragments Json? // list of {filePath, snippetA, snippetB}
  createdAt         DateTime @default(now())

  // relations (optional, for query convenience)
  submissionA Submission @relation("SimilarityA", fields: [submissionAId], references: [id])
  submissionB Submission @relation("SimilarityB", fields: [submissionBId], references: [id])

  @@unique([hackathonId, submissionAId, submissionBId])
  @@index([hackathonId])
}

model Feedback {
  id           String   @id @default(cuid())
  submissionId String   @unique
  content      String // generated feedback markdown/text
  generatedAt  DateTime @default(now())
  createdById  String? // judge or system user

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  creator    User?      @relation(fields: [createdById], references: [id])

  @@index([submissionId])
}

model SecurityFinding {
  id             String          @id @default(cuid())
  submissionId   String
  severity       FindingSeverity
  category       FindingCategory @default(SECURITY)
  title          String
  description    String
  filePath       String?
  lineNumber     Int?
  columnNumber   Int?
  codeSnippet    String? // masked, never raw secrets
  evidence       String?
  recommendation String?
  cwe            String?
  ruleId         String?
  falsePositive  Boolean         @default(false)
  status         FindingStatus   @default(OPEN)
  teamName       String?
  problemTitle   String?
  createdAt      DateTime        @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([severity])
  @@index([status])
}

model RuntimeTest {
  id             String            @id @default(cuid())
  submissionId   String
  name           String
  description    String?
  category       String            @default("STATIC")
  status         RuntimeTestStatus @default(PENDING)
  duration       Float?
  httpStatus     Int?
  stdout         String?
  stderr         String?
  errorMessage   String?
  expectedOutput String?
  actualOutput   String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([status])
}

model EvaluationPipeline {
  id                  String                  @id @default(cuid())
  submissionId        String                  @unique
  mappingStatus       PipelineComponentStatus @default(PENDING)
  securityStatus      PipelineComponentStatus @default(PENDING)
  runtimeStatus       PipelineComponentStatus @default(PENDING)
  mappingError        String?
  securityError       String?
  runtimeError        String?
  startedAt           DateTime?
  mappingCompletedAt  DateTime?
  securityCompletedAt DateTime?
  runtimeCompletedAt  DateTime?
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Judge {
  id          String @id @default(cuid())
  userId      String
  hackathonId String

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon    @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  scores    JudgeScore[]

  @@unique([userId, hackathonId])
}

model JudgeScore {
  id           String        @id @default(cuid())
  judgeId      String?
  userId       String
  submissionId String
  dimension    EvalDimension
  score        Float
  comment      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  judge      Judge?     @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId, dimension])
  @@index([submissionId])
  @@index([userId])
}

model FinalResult {
  id              String         @id @default(cuid())
  submissionId    String         @unique
  aiScore         Float?
  judgeScore      Float?
  finalScore      Float?
  rank            Int?
  status          AnalysisStatus @default(COMPLETED)
  dimensionScores Json?
  judgeOverrides  Json?
  judgeComments   String?
  weightsUsed     Json?
  generatedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([finalScore])
}

model ScoringConfig {
  id          String   @id @default("default")
  hackathonId String?  @unique
  weights     Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entity])
}
